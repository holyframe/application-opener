{
  "manifest_version": 3,
  "name": "Application Opener",
  "description": "Open application rows from Google Sheets in per-tab resume workspaces, with Google Docs PDF downloads.",
  "version": "1.0.34",
  "permissions": [
    "sidePanel",
    "storage",
    "identity",
    "tabs",
    "scripting",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://docs.google.com/*",
    "https://docs.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content/ai-provider.js"
      ],
      "run_at": "document_start"
    }
  ],
  "oauth2": {
    "client_id": "1087409152703-hvi25ibge9k1rg16sqb9f1vekhpe2keg.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "action": {
    "default_title": "Open Application Opener",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "commands": {
    "make-resume": {
      "description": "Open Make Resume"
    },
    "download-resume": {
      "description": "Download the current workspace resume"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
